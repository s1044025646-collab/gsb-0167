{
  "name": "wall-conduction",
  "version": "1.0.0",
  "description": "One-dimensional transient multilayer wall conduction solver with energy accounting (FVM, backward Euler)",
  "type": "module",
  "bin": {
    "wall": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node --no-warnings dist/api/server.js",
    "dev": "node --no-warnings --import tsx src/api/server.ts",
    "serve": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "clean": "node scripts/clean.mjs",
    "cli": "node --no-warnings --import tsx src/cli/index.ts",
    "demo": "node --no-warnings --import tsx scripts/demo.ts",
    "test": "node --no-warnings --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
